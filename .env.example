NODE_ENV=development
PORT=3000

POSTGRES_DB=amrutam
POSTGRES_USER=amrutam_app
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql://amrutam_app:replace_with_a_local_password@localhost:5433/amrutam?schema=public

REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=use_a_different_random_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MFA_ENCRYPTION_KEY=replace_with_64_character_hex_key

# Required only when running the local demo seed:
SEED_DOCTOR_EMAIL=doctor.demo@amrutam.local
# Set SEED_DOCTOR_PASSWORD in your shell; do not commit it.
